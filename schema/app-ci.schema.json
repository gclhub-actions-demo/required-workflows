{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Centrally governed application CI manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projects"],
  "properties": {
    "version": {"const": 1},
    "projects": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {"enum": ["java", "node", "python", "dotnet"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "extensions": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "preflight": {"$ref": "#/$defs/script"},
        "postflight": {"$ref": "#/$defs/script"}
      }
    }
  },
  "$defs": {
    "script": {
      "type": "string", "maxLength": 200,
      "pattern": "^(?:(?:[A-Za-z0-9_-]+|\\.github)/)?(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.sh$"
    }
  }
}
